# Copy to an ignored .env; replace placeholders locally. Never commit secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Generate at least 32 random bytes, for example:
# node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
# Canonical production origin is https://redtally.vercel.app.
BETTER_AUTH_URL="http://localhost:3000"

# Separate random secret for the daily recurring expense worker.
CRON_SECRET=""
