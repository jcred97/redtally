// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  BANK_PAYMENT
  CASH
  PAY_LATER

  @@map("TransactionType")
}

enum FinancialAccountType {
  CASH
  SAVINGS
  CHECKING
  WALLET
  CREDIT_CARD
  PAY_LATER
  OTHER
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringExpenseStatus {
  ACTIVE
  PAUSED
  NEEDS_ATTENTION
}

model ExpenseGroup {
  id                 Int                 @id @default(autoincrement())
  publicId           String              @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  categories         Category[]
  budgets            Budget[]
  bankAssignments    BankAssignment[]
  creditAccountAssignments CreditAccountAssignment[]
  payLaterProviders  ExpenseGroupPayLaterProvider[]
  expenseSubmissions ExpenseSubmission[]
  recurringExpenses  RecurringExpense[]
  recurringExpenseSubmissions RecurringExpenseSubmission[]
  loans              Loan[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  // Null means preserved, unclaimed legacy data; never visible to signed-in users.
  userId             String?
  user               User?               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@unique([id, userId])
  @@map("Spending")
}

model Category {
  id             Int          @id @default(autoincrement())
  name           String
  icon           String?
  color          String?
  expenseGroupId Int          @map("spendingId")
  expenseGroup   ExpenseGroup @relation(fields: [expenseGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Category_spendingId_fkey")
  expenses       Expense[]
  recurringExpenses RecurringExpense[]
  createdAt      DateTime     @default(now())

  @@unique([id, expenseGroupId], map: "Category_id_spendingId_key")
}

model Expense {
  id               Int             @id @default(autoincrement())
  title            String
  merchant         String?         @db.VarChar(100)
  amountCentavos   Int
  date             DateTime
  timeMinutes      Int?            @db.SmallInt
  notes            String?
  legacyBankName   String?         @map("bank")
  bankAssignmentId Int?
  expenseGroupId   Int
  paymentMethod    PaymentMethod?  @map("transactionType")
  categoryId       Int
  category         Category        @relation(fields: [categoryId, expenseGroupId], references: [id, expenseGroupId], onDelete: Restrict, onUpdate: Cascade)
  bankAssignment   BankAssignment? @relation(fields: [bankAssignmentId, expenseGroupId], references: [id, expenseGroupId], onDelete: Restrict, onUpdate: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  submission       ExpenseSubmission?
  recurringOccurrence RecurringExpenseOccurrence?
  repaymentPlan    RepaymentPlan?

  @@index([expenseGroupId, date])
  @@index([categoryId, expenseGroupId])
  @@index([bankAssignmentId, expenseGroupId])
}

model ExpenseSubmission {
  id             String       @db.Uuid
  expenseGroupId Int
  expenseGroup   ExpenseGroup @relation(fields: [expenseGroupId], references: [id], onDelete: Cascade)
  payloadHash    String
  // Keep the submission after expense deletion so a late retry cannot recreate it.
  expenseId      Int?         @unique
  expense        Expense?     @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@id([expenseGroupId, id])
}

model RecurringExpense {
  id               Int                         @id @default(autoincrement())
  expenseGroupId   Int
  expenseGroup     ExpenseGroup                @relation(fields: [expenseGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoryId       Int
  category         Category                    @relation(fields: [categoryId, expenseGroupId], references: [id, expenseGroupId], onDelete: Restrict, onUpdate: Cascade)
  bankAssignmentId Int?
  bankAssignment   BankAssignment?             @relation(fields: [bankAssignmentId, expenseGroupId], references: [id, expenseGroupId], onDelete: Restrict, onUpdate: Cascade)
  title            String
  amountCentavos   Int
  paymentMethod    PaymentMethod?
  frequency        RecurrenceFrequency
  startDate        DateTime                    @db.Date
  endDate          DateTime?                   @db.Date
  nextDueDate      DateTime                    @db.Date
  status           RecurringExpenseStatus      @default(ACTIVE)
  occurrences      RecurringExpenseOccurrence[]
  submission       RecurringExpenseSubmission?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([expenseGroupId])
  @@index([categoryId, expenseGroupId])
  @@index([bankAssignmentId, expenseGroupId])
  @@index([status, nextDueDate, id])
}

model RecurringExpenseSubmission {
  expenseGroupId     Int
  id                 String            @db.Uuid
  payloadHash        String
  recurringExpenseId Int?              @unique
  expenseGroup       ExpenseGroup      @relation(fields: [expenseGroupId], references: [id], onDelete: Cascade)
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  @@id([expenseGroupId, id])
}

model RecurringExpenseOccurrence {
  recurringExpenseId Int
  recurringExpense   RecurringExpense @relation(fields: [recurringExpenseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dueDate            DateTime         @db.Date
  // An occurrence stays recorded when its expense is deleted.
  expenseId          Int?             @unique
  expense            Expense?         @relation(fields: [expenseId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@id([recurringExpenseId, dueDate])
}

// Monthly targets for now, matching the Salesforce application.
model Budget {
  id             Int          @id @default(autoincrement())
  expenseGroupId Int
  expenseGroup   ExpenseGroup @relation(fields: [expenseGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  budgetMonth    DateTime     @db.Date
  amountCentavos Int
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([expenseGroupId, budgetMonth])
}

model Bank {
  id          Int              @id @default(autoincrement())
  name        String
  key         String           @unique
  active      Boolean          @default(true)
  assignments BankAssignment[]
  financialAccounts FinancialAccount[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model FinancialAccount {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  name              String               @db.VarChar(120)
  type              FinancialAccountType
  currency          String               @default("PHP") @db.Char(3)
  active            Boolean              @default(true)
  bankId            Int?
  bank              Bank?                @relation(fields: [bankId], references: [id], onDelete: Restrict)
  payLaterAccountId String?              @db.Uuid
  payLaterAccount   PayLaterAccount?     @relation(fields: [payLaterAccountId, userId], references: [id, userId], onDelete: Restrict)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([payLaterAccountId, userId])
  @@index([userId, name])
  @@index([bankId])
}

model BankAssignment {
  id                    Int          @id @default(autoincrement())
  expenseGroupId        Int
  expenseGroup          ExpenseGroup @relation(fields: [expenseGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bankId                Int
  bank                  Bank         @relation(fields: [bankId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  active                Boolean      @default(true)
  supportedDebitCard    Boolean      @default(true)
  supportedCreditCard   Boolean      @default(true)
  supportedBankTransfer Boolean      @default(true)
  supportedBankPayment  Boolean      @default(true)
  expenses              Expense[]
  recurringExpenses     RecurringExpense[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@unique([expenseGroupId, bankId])
  @@unique([id, expenseGroupId])
  @@index([bankId])
  @@map("ExpenseGroupBank")
}

model Loan {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  expenseGroupId     Int?
  expenseGroup       ExpenseGroup?     @relation(fields: [expenseGroupId, userId], references: [id, userId], onDelete: Restrict)
  title              String            @db.VarChar(120)
  lender             String            @db.VarChar(120)
  amountCentavos     Int
  disbursementDate   DateTime          @db.Date
  receivingAccount   String            @db.VarChar(120)
  repaymentFrequency String?           @db.VarChar(16)
  installments       LoanInstallment[]
  submissionId       String            @db.Uuid
  payloadHash        String
  createdAt          DateTime          @default(now())

  @@unique([userId, submissionId])
  @@index([expenseGroupId, userId])
}

model PayLaterAccount {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  name      String          @db.VarChar(120)
  key       String          @db.VarChar(120)
  providerKey String        @db.VarChar(127)
  providerName String?      @db.VarChar(120)
  enabled   Boolean         @default(true)
  plans     RepaymentPlan[]
  assignments CreditAccountAssignment[]
  financialAccount FinancialAccount?
  createdAt DateTime        @default(now())

  @@unique([userId, key])
  @@unique([id, userId])
  @@index([userId, providerKey])
}

model ExpenseGroupPayLaterProvider {
  expenseGroupId Int
  userId         String
  providerKey    String       @db.VarChar(127)
  providerName   String?      @db.VarChar(120)
  active         Boolean      @default(true)
  expenseGroup   ExpenseGroup @relation(fields: [expenseGroupId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Cascade)

  @@id([expenseGroupId, providerKey])
}

model CreditAccountAssignment {
  expenseGroupId   Int
  creditAccountId  String          @db.Uuid
  userId           String
  expenseGroup     ExpenseGroup    @relation(fields: [expenseGroupId, userId], references: [id, userId], onDelete: Cascade)
  creditAccount    PayLaterAccount @relation(fields: [creditAccountId, userId], references: [id, userId], onDelete: Cascade)
  active           Boolean         @default(true)
  supportsPayLater Boolean         @default(true)

  @@id([expenseGroupId, creditAccountId])
  @@index([creditAccountId, userId])
}

model RepaymentPlan {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expenseId       Int               @unique
  expense         Expense           @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  creditAccountId String            @db.Uuid
  creditAccount   PayLaterAccount   @relation(fields: [creditAccountId], references: [id], onDelete: Restrict)
  installments    LoanInstallment[]
  createdAt       DateTime          @default(now())

  @@index([creditAccountId])
}

model LoanInstallment {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loanId         String?                 @db.Uuid
  loan           Loan?                   @relation(fields: [loanId], references: [id], onDelete: Restrict)
  planId         String?                 @db.Uuid
  plan           RepaymentPlan?          @relation(fields: [planId], references: [id], onDelete: Restrict)
  dueDate        DateTime                @db.Date
  amountCentavos Int
  allocations    LoanPaymentAllocation[]

  @@unique([loanId, dueDate])
  @@unique([planId, dueDate])
}

model LoanPayment {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String
  user           User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  paidOn         DateTime                @db.Date
  fundingAccount String                  @db.VarChar(120)
  amountCentavos Int
  submissionId   String                  @db.Uuid
  payloadHash    String
  allocations    LoanPaymentAllocation[]
  createdAt      DateTime                @default(now())

  @@unique([userId, submissionId])
}

model LoanPaymentAllocation {
  paymentId      String          @db.Uuid
  payment        LoanPayment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  installmentId  String          @db.Uuid
  installment    LoanInstallment @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  amountCentavos Int

  @@id([paymentId, installmentId])
  @@index([installmentId])
}

model User {
  id            String         @id
  name          String
  email         String         @unique
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  expenseGroups ExpenseGroup[]
  receiptScanner ReceiptScanner?
  loans          Loan[]
  financialAccounts FinancialAccount[]
  payLaterAccounts PayLaterAccount[]
  loanPayments   LoanPayment[]

  @@map("user")
}

model ReceiptScanner {
  userId       String @id
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  encryptedKey String
  keySuffix    String
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}
