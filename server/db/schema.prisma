// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  BANK_PAYMENT
  CASH

  @@map("TransactionType")
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringExpenseStatus {
  ACTIVE
  PAUSED
  NEEDS_ATTENTION
}

model ExpenseGroup {
  id                 Int                 @id @default(autoincrement())
  name               String
  categories         Category[]
  budgets            Budget[]
  bankAssignments    BankAssignment[]
  expenseSubmissions ExpenseSubmission[]
  recurringExpenses  RecurringExpense[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  // Null means preserved, unclaimed legacy data; never visible to signed-in users.
  userId             String?
  user               User?               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@map("Spending")
}

model Category {
  id             Int          @id @default(autoincrement())
  name           String
  icon           String?
  color          String?
  expenseGroupId Int          @map("spendingId")
  expenseGroup   ExpenseGroup @relation(fields: [expenseGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Category_spendingId_fkey")
  expenses       Expense[]
  recurringExpenses RecurringExpense[]
  createdAt      DateTime     @default(now())

  @@unique([id, expenseGroupId], map: "Category_id_spendingId_key")
}

model Expense {
  id               Int             @id @default(autoincrement())
  title            String
  amountCentavos   Int
  date             DateTime
  timeMinutes      Int?            @db.SmallInt
  notes            String?
  legacyBankName   String?         @map("bank")
  bankAssignmentId Int?
  expenseGroupId   Int
  paymentMethod    PaymentMethod?  @map("transactionType")
  categoryId       Int
  category         Category        @relation(fields: [categoryId, expenseGroupId], references: [id, expenseGroupId], onDelete: Restrict, onUpdate: Cascade)
  bankAssignment   BankAssignment? @relation(fields: [bankAssignmentId, expenseGroupId], references: [id, expenseGroupId], onDelete: Restrict, onUpdate: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  submission       ExpenseSubmission?
  recurringOccurrence RecurringExpenseOccurrence?

  @@index([expenseGroupId, date])
  @@index([categoryId, expenseGroupId])
  @@index([bankAssignmentId, expenseGroupId])
}

model ExpenseSubmission {
  id             String       @db.Uuid
  expenseGroupId Int
  expenseGroup   ExpenseGroup @relation(fields: [expenseGroupId], references: [id], onDelete: Cascade)
  payloadHash    String
  // Keep the submission after expense deletion so a late retry cannot recreate it.
  expenseId      Int?         @unique
  expense        Expense?     @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@id([expenseGroupId, id])
}

model RecurringExpense {
  id               Int                         @id @default(autoincrement())
  expenseGroupId   Int
  expenseGroup     ExpenseGroup                @relation(fields: [expenseGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoryId       Int
  category         Category                    @relation(fields: [categoryId, expenseGroupId], references: [id, expenseGroupId], onDelete: Restrict, onUpdate: Cascade)
  bankAssignmentId Int?
  bankAssignment   BankAssignment?             @relation(fields: [bankAssignmentId, expenseGroupId], references: [id, expenseGroupId], onDelete: Restrict, onUpdate: Cascade)
  title            String
  amountCentavos   Int
  paymentMethod    PaymentMethod?
  frequency        RecurrenceFrequency
  startDate        DateTime                    @db.Date
  endDate          DateTime?                   @db.Date
  nextDueDate      DateTime                    @db.Date
  status           RecurringExpenseStatus      @default(ACTIVE)
  occurrences      RecurringExpenseOccurrence[]
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([expenseGroupId])
  @@index([categoryId, expenseGroupId])
  @@index([bankAssignmentId, expenseGroupId])
  @@index([status, nextDueDate, id])
}

model RecurringExpenseOccurrence {
  recurringExpenseId Int
  recurringExpense   RecurringExpense @relation(fields: [recurringExpenseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dueDate            DateTime         @db.Date
  // An occurrence stays recorded when its expense is deleted.
  expenseId          Int?             @unique
  expense            Expense?         @relation(fields: [expenseId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@id([recurringExpenseId, dueDate])
}

// Monthly targets for now, matching the Salesforce application.
model Budget {
  id             Int          @id @default(autoincrement())
  expenseGroupId Int
  expenseGroup   ExpenseGroup @relation(fields: [expenseGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  budgetMonth    DateTime     @db.Date
  amountCentavos Int
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([expenseGroupId, budgetMonth])
}

model Bank {
  id          Int              @id @default(autoincrement())
  name        String
  key         String           @unique
  active      Boolean          @default(true)
  assignments BankAssignment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model BankAssignment {
  id                    Int          @id @default(autoincrement())
  expenseGroupId        Int
  expenseGroup          ExpenseGroup @relation(fields: [expenseGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bankId                Int
  bank                  Bank         @relation(fields: [bankId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  active                Boolean      @default(true)
  supportedDebitCard    Boolean      @default(true)
  supportedCreditCard   Boolean      @default(true)
  supportedBankTransfer Boolean      @default(true)
  supportedBankPayment  Boolean      @default(true)
  expenses              Expense[]
  recurringExpenses     RecurringExpense[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@unique([expenseGroupId, bankId])
  @@unique([id, expenseGroupId])
  @@index([bankId])
  @@map("ExpenseGroupBank")
}

model User {
  id            String         @id
  name          String
  email         String         @unique
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  expenseGroups ExpenseGroup[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}
